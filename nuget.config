<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One package source, so restore is reproducible on every machine and runner (document 07, part 1). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
